{
  "name": "saas-portal",
  "version": "0.1.0",
  "description": "\u5ba2\u6237\u5165\u53e3\u4e0e\u5e94\u7528\u6570\u636e\u5165\u53e3\uff1a\u5bfc\u822a\u3001\u79df\u6237\u5207\u6362\u3001\u504f\u597d\u3001\u4f1a\u8bdd BFF\u3001\u4ee3\u7406\u3002\u53ea\u62e5\u6709\u504f\u597d\u7b49 Portal \u6570\u636e\uff1bAuth/Registry/\u8ba1\u8d39\u4e8b\u5b9e\u901a\u8fc7\u670d\u52a1 API \u83b7\u53d6\u3002",
  "scripts": {
    "dev": "node server.ts --dev",
    "build": "next build",
    "start": "node server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.ts",
    "session:prune": "node scripts/prune.ts",
    "test:integration": "bash integration/test.sh",
    "format:check": "prettier --check app lib scripts tests integration/*.ts next.config.ts proxy.ts server.ts"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "jose": "6.2.2",
    "next": "16.3.5",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
