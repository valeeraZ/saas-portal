{
  "name": "saas-portal",
  "version": "0.1.0",
  "description": "客户入口与应用数据入口：导航、租户切换、偏好、会话 BFF、代理。只拥有偏好等 Portal 数据；Auth/Registry/计费事实通过服务 API 获取。",
  "scripts": {
    "dev": "node server.ts --dev",
    "build": "next build",
    "start": "node server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:migrate": "node scripts/migrate.ts",
    "session:prune": "node scripts/prune.ts",
    "test:integration": "bash integration/test.sh",
    "format:check": "prettier --check app lib scripts tests integration/*.ts next.config.ts proxy.ts server.ts",
    "test:runtime-registry": "node integration/runtime-registry.test.ts"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "jose": "6.2.2",
    "next": "16.3.5",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
