PORTAL_ORIGIN=https://127.0.0.1:58999
PORTAL_OIDC_ISSUER=https://127.0.0.1:58443/realms/saas-local
PORTAL_OIDC_CLIENT_ID=saas-portal
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_AUTH_URL=http://127.0.0.1:58000
PORTAL_ALLOW_LOCAL_HTTP=true
PORTAL_DATABASE_URL=postgresql://portal:CHANGE_ME@127.0.0.1:55434/portal
# Generate with: openssl rand -base64 32; keep stable across replicas.
PORTAL_SESSION_KEY=
# Local TLS only: NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-local-ca.crt

PORTAL_ADMIN_URL=http://127.0.0.1:59100
PORTAL_ADMIN_KEY=

# Tenant application proxy: private key file only on Portal; apps get the public key.
PORTAL_APP_SIGNING_KEY_FILE=/run/secrets/portal-app-private.pem
PORTAL_APP_KEY_ID=portal-1
PORTAL_ALLOWED_APP_ORIGINS=https://reports.internal.example
